# Base de données (injectée par l'intégration Neon sur Vercel)
# En local : branche Neon « dev », JAMAIS la prod (docs/WORKFLOW.md)
DATABASE_URL=
DATABASE_URL_UNPOOLED=        # migrations (drizzle-kit)
LOCAL_DB_BRANCH=dev           # marqueur exigé par drizzle.config.ts en local

# Vercel Blob (auth OIDC : VERCEL_OIDC_TOKEN injecté par Vercel, ~12 h en local)
# Production : BLOB_PROD_STORE_ID · Preview/local : BLOB_PREVIEW_STORE_ID (une seule des deux)
BLOB_PREVIEW_STORE_ID=
VERCEL_OIDC_TOKEN=

# Auth
BETTER_AUTH_SECRET=           # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_OPEN=true               # vitrine ouverte ; absent/≠ "true" = page d'attente (production avant le lancement)

# Contact (Resend). Sans ces 3 variables : en local l'e-mail est affiché dans le terminal,
# en production le formulaire répond « indisponible » (et propose l'e-mail).
RESEND_API_KEY=
CONTACT_TO_EMAIL=             # adresse qui REÇOIT les messages
CONTACT_FROM_EMAIL=           # expéditeur sur un domaine vérifié chez Resend, ex. "Portfolio <contact@williamulses.fr>"

# Scripts locaux uniquement
ADMIN_EMAIL=
